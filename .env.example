# --- DATABASE & ORM ---
DATABASE_URL="postgresql://user:password@localhost:5432/pixbay?schema=public"
# For Prisma v7+ with Driver Adapters, ensure the provider matches (postgresql/mysql/sqlite)

# --- SERVER CONFIG ---
DEV_PORT=3000
JWT_SECRET="generate-a-long-random-string-here"
SALT_ROUNDS=10

# --- STORAGE (SUPABASE) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET="pixbay"

# --- EMAIL (AHASEND / SMTP) ---
SMTP_HOST="smtp.ahasend.com"
SMTP_PORT=587
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Pixbay Marketplace <noreply@pixbay.com>"

# --- NOTIFICATIONS (FIREBASE) ---
# Note: Firebase Admin SDK usually requires a JSON credential file.
# Point to your service account path or paste relevant fields if using env-based init.
FIREBASE_PROJECT_ID="your-project-id"

# --- ENVIRONMENT ---
NODE_ENV="development"

# --- REDIS & QUEUE ---
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_URL="redis://127.0.0.1:6379"
